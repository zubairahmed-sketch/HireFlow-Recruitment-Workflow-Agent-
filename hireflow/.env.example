# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Neon Database (Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/hireflow?sslmode=require

# LLM Provider (pick one — Gemini is free, OpenAI requires billing)
# Get your free Gemini API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Or use OpenAI (requires billing): 
# OPENAI_API_KEY=sk-...

# Uploadthing (resume file storage)
UPLOADTHING_TOKEN=...

# n8n integration
# Token that n8n sends in Authorization: Bearer <token> for service calls
# Generate with: openssl rand -hex 32
N8N_SERVICE_TOKEN=your-random-secret-token

# App base URL (used by n8n to call back into the app)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
APP_BASE_URL=http://localhost:3000

# n8n Webhook URL (get from Webhook node's Production URL after importing workflow)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/application-received
