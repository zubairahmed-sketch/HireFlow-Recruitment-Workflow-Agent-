# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Neon Database (Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/hireflow?sslmode=require

# OpenAI
OPENAI_API_KEY=sk-...

# Uploadthing (resume file storage)
UPLOADTHING_TOKEN=...

# n8n integration
# Token that n8n sends in Authorization: Bearer <token> for service calls
# Generate with: openssl rand -hex 32
N8N_SERVICE_TOKEN=your-random-secret-token

# App base URL (used by n8n to call back into the app)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
APP_BASE_URL=http://localhost:3000
